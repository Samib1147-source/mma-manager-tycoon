.screen { flex-grow: 1; background-color: #171718; color: rgb(238,231,216); padding: 24px 60px 18px; font-size: 18px; }
.masthead { flex-direction: row; justify-content: space-between; align-items: center; height: 54px; flex-shrink: 0; margin-bottom: 18px; }
.brand { flex-direction: row; align-items: center; }
.brand-mark { font-size: 48px; -unity-font-style: bold; letter-spacing: 0; }
.brand-rule { width: 4px; height: 27px; margin: 0 18px; background-color: #ce7756; }
.brand-word { font-size: 24px; letter-spacing: 4px; -unity-font-style: bold; }
.masthead-note { font-size: 14px; letter-spacing: 1px; color: rgb(148,148,142); }
.content { flex-direction: row; flex-grow: 1; min-height: 0; }
.portrait-panel { width: 50%; margin-right: 40px; overflow: hidden; background-color: rgb(36,34,30); border-width: 4px; border-color: #8c7050; }
.fighter-preview { position: absolute; top: 0; left: 0; right: 0; bottom: 0; }
.portrait-top { position: absolute; left: 30px; right: 30px; top: 27px; }
.eyebrow { font-size: 14px; -unity-font-style: bold; letter-spacing: 1px; color: rgb(217,183,130); }
.portrait-title { font-size: 40px; -unity-font-style: bold; margin-top: 9px; white-space: normal; color: rgb(244,233,212); text-shadow: 2px 2px 0 rgba(0,0,0,0.7); }
.portrait-bottom { position: absolute; left: 0; right: 0; bottom: 0; padding: 24px 30px 20px; background-color: #222020; border-top-width: 4px; border-top-color: #8c7050; }
.muted { color: rgb(143,145,136); font-size: 12px; }
.preview-name { font-size: 36px; -unity-font-style: bold; margin-top: 6px; overflow: hidden; text-overflow: ellipsis; }
.preview-nickname { color: rgb(205,175,127); font-size: 20px; margin-top: 1px; overflow: hidden; text-overflow: ellipsis; }
.preview-details { flex-direction: row; justify-content: space-between; margin-top: 20px; color: rgb(158,162,153); font-size: 14px; letter-spacing: 0; }
.form-panel { flex-grow: 1; flex-basis: 0; padding: 4px 0 0; min-width: 0; }
.section-kicker { flex-direction: row; align-items: center; }
.step-number { background-color: #b06c45; color: #191719; font-size: 16px; padding: 3px 10px; margin-right: 12px; -unity-font-style: bold;  height: 26px; }
.form-title { font-size: 44px; -unity-font-style: bold; letter-spacing: 0; margin-top: 8px; }
.intro { color: rgb(160,161,154); font-size: 18px; margin-top: 3px; white-space: normal; }
.divider { height: 3px; background-color: #4b4035; margin: 14px 0 12px; flex-shrink: 0; }
.section-heading { flex-direction: row; justify-content: space-between; align-items: center; }
.helper { color: rgb(153,157,150); font-size: 14px; }
.field-label { font-size: 13px; letter-spacing: 1px; color: rgb(181,183,173); margin-top: 10px; margin-bottom: 5px; }
.field-label-row { flex-direction: row; align-items: flex-end; justify-content: space-between; }
.field-label-row .helper { margin-bottom: 5px; font-size: 14px; }
.text-field { height: 44px; margin: 0; padding: 0; flex-shrink: 0; }
.text-field .unity-base-text-field__input { background-image: none; background-color: #222222; color: rgb(240,234,221); border-width: 3px; border-color: #665846; border-radius: 0; padding: 8px 12px; margin: 0; font-size: 20px; }
.text-field .unity-base-text-field__input:focus { border-color: rgb(215,173,113); background-color: rgb(34,37,37); }
.text-field .unity-text-field__placeholder { color: rgb(121,127,121); }
Button { margin: 0; border-radius: 0; border-width: 3px; -unity-font-style: normal;  background-image: none; }
Button:focus { border-color: rgb(242,207,151); }
.country-button { height: 44px; background-color: #222222; color: rgb(215,214,200); border-color: #665846; -unity-text-align: middle-left; padding-left: 14px; font-size: 20px; flex-shrink: 0; }
.country-button:hover { background-color: rgb(42,44,42); border-color: rgb(164,138,99); }
.appearance-divider { margin-top: 18px; margin-bottom: 14px; }
.skin-label { margin-top: 10px; }
.skin-tones { flex-direction: row; height: 44px; flex-shrink: 0; }
.tone { width: 56px; height: 44px; margin-right: 12px; border-width: 4px; border-color: rgb(17,19,20); padding: 3px; }
.tone:hover { border-color: rgb(146,142,123); }
.tone.selected { border-color: rgb(242,222,183); }
.tone:focus { border-color: white; }
.tone-check { color: rgb(255,255,244); -unity-text-align: middle-center; font-size: 18px; -unity-font-style: bold; flex-grow: 1; text-shadow: 2px 2px 0 rgba(0,0,0,0.7); }
.form-spacer { flex-grow: 1; min-height: 10px; }
.status { font-size: 14px; color: rgb(155,159,147); margin-bottom: 10px; white-space: normal; min-height: 16px; }
.status.error { color: rgb(246,156,136); }
.status.saved { color: rgb(189,211,158); }
.primary-button { height: 56px; font-size: 16px; -unity-font-style: bold; letter-spacing: 1px; color: rgb(28,24,19); background-color: #d8ac6d; border-color: rgb(216,175,116); flex-shrink: 0;  border-top-color: #f6d697;  border-left-color: #f6d697;  border-bottom-color: #805737;  border-right-color: #805737; }
.primary-button:hover { background-color: rgb(239,199,140); border-color: rgb(255,223,173); }
.primary-button:active { background-color: rgb(191,145,87); }
.save-note { color: rgb(130,138,130); font-size: 13px; -unity-text-align: middle-center; margin-top: 10px; }
.footer { flex-direction: row; justify-content: space-between; font-size: 12px; letter-spacing: 1px; color: rgb(116,124,119); margin-top: 20px; height: 16px; flex-shrink: 0; }
.overlay { position: absolute; top: 0; bottom: 0; left: 0; right: 0; background-color: rgba(0,0,0,0.8); align-items: center; justify-content: center; }
.hidden { display: none; }
.country-dialog { width: 540px; height: 630px; padding: 28px; background-color: #242121; border-width: 4px; border-color: #b38c59; }
.dialog-title { font-size: 30px; -unity-font-style: bold; }
.close-button { background-color: rgb(40,44,42); color: rgb(206,208,194); border-color: rgb(67,72,66); height: 36px; width: 90px; font-size: 16px; }
.country-search { margin-top: 22px; margin-bottom: 14px; }
.country-list { flex-grow: 1; }
.country-row { height: 44px; padding-left: 12px; -unity-text-align: middle-left; font-size: 20px; background-color: rgb(31,35,34); border-width: 0; border-bottom-width: 1px; border-bottom-color: rgb(44,48,44); color: rgb(219,222,207); }
.country-row:hover, .country-row:focus { background-color: rgb(75,62,44); color: rgb(255,229,186); }
.country-count { margin-top: 12px; }
.compact .screen { padding-top: 18px; padding-bottom: 14px; }
.compact .masthead { height: 45px; margin-bottom: 15px; }
.compact .form-title { font-size: 38px; margin-top: 6px; }
.compact .divider { margin-top: 14px; margin-bottom: 12px; }
.compact .field-label { margin-top: 10px; }
.compact .footer { margin-top: 12px; }

.preview-details > Label { overflow: hidden; text-overflow: ellipsis; max-width: 65%; }

.career-actions { flex-direction: row; height: 56px; flex-shrink: 0; }
.career-actions #save-fighter { width: 31%; margin-right: 12px; font-size: 14px; letter-spacing: 0; background-color: rgb(36,39,37); color: rgb(210,204,189); border-color: rgb(71,73,66); }
.career-actions #begin-life { flex-grow: 1; font-size: 16px; letter-spacing: 0; }

.primary-button:active { border-top-color: #805737; border-left-color: #805737; border-bottom-color: #f6d697; border-right-color: #f6d697; }

.form-panel Label, .section-kicker, .field-label-row, .section-heading { flex-shrink: 0; }
